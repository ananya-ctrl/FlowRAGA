ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://flowraga:change-me@postgres:5432/flowraga
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false
RUN_EMBEDDED_WORKERS=false
STORAGE_ROOT=./data/uploads
STORAGE_BACKEND=local
# For Cloudflare R2 or another S3-compatible private bucket:
# S3_BUCKET=flowraga
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# S3_KEY_PREFIX=uploads
MAX_UPLOAD_BYTES=26214400
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=50
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# Hosted production generation (open-weight Llama on Groq):
# GENERATION_PROVIDER=groq
# GROQ_API_KEY=replace-me
# GROQ_MODEL=llama-3.3-70b-versatile
GENERATION_MAX_TOKENS=1200
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_DEFAULT_THRESHOLD=0.25
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
NEXT_PUBLIC_API_URL=http://localhost:8000
